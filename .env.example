# Copy to .env.local (web app) or .env (repo root for the Supabase CLI).
# Nothing here is a real value. Never commit a filled-in copy.

# --- public, safe in the browser -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- server only -----------------------------------------------------------
# Bypasses RLS. Used by the demo seed, gateway webhooks and the attendance scan.
# Never prefix this with NEXT_PUBLIC_ and never import it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- local CLI (not needed on a hosted project) ----------------------------
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
